{
  "version": 2,
  "framework": null,
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "echo ok",
  "outputDirectory": "public",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 60 }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/v1/(.*)", "dest": "/api/index.py" },
    { "src": "/health", "dest": "/api/index.py" },
    { "src": "/ready", "dest": "/api/index.py" },
    { "src": "/debug-imports", "dest": "/api/index.py" },
    { "src": "/metrics", "dest": "/api/index.py" },
    { "src": "/docs", "dest": "/api/index.py" },
    { "src": "/app", "dest": "/public/app.html" },
    { "src": "/login", "dest": "/public/app.html" },
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/js/(.*)", "dest": "/public/js/$1" },
    { "src": "/", "dest": "/public/app.html" }
  ]
}
